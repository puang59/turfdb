import row::Row;
import row::print_row;
import table::Table;
import pager::TABLE_MAX_ROWS;
import statement::Statement;
import statement::StatementType;

import cursor::Cursor;
import cursor::table_start;
import cursor::table_end;

pub enum ExecuteResult { Success, TableFull }

fn execute_insert(statement: &Statement, table: &Table): ExecuteResult {
    if table.num_rows >= TABLE_MAX_ROWS {
        return ExecuteResult::TableFull;
    }

    // open a cursor at the end of the table and write the row there
    mut cursor: Cursor = table_end(table);
    cursor.insert(statement.row_to_insert);

    return ExecuteResult::Success;
}

fn execute_select(statement: &Statement, table: &Table): ExecuteResult {
    // start at the first row, print it, move on, stop past the last row 
    mut cursor: Cursor = table_start(table);
    
    while !cursor.end_of_table {
        immut row: Row = cursor.value();
        print_row(&row);
        cursor.advance();
    }

    return ExecuteResult::Success;
}

// dispatch on the statement kind
pub fn execute_statement(statement: &Statement, table: &Table): ExecuteResult {
    compare statement.kind {
        matches StatementType::Insert:
        return execute_insert(statement, table);
        done
        matches StatementType::Select:
        return execute_select(statement, table);
        done
    }
}
