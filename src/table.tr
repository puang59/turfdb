import list::List;
import row::Row;
import pager::Pager;
import pager::ROWS_PER_PAGE;

// the table only knows how many rows it has, the pager holds the actual pages
pub struct Table {
    pub num_rows: int,
    pub pager: Pager
}

// db_open: open the file through the pager, row count comes from the file
pub fn Table.new(filename: string): void {
    self.pager = Pager::new(filename);
    self.num_rows = self.pager.file_rows;
}

// get row number n: page = n / 14, position inside that page = n % 14
pub fn Table.row_at(row_num: int): Row {
    immut page: List<Row> = self.pager.get_page(row_num/ ROWS_PER_PAGE);
    return page[row_num % ROWS_PER_PAGE];
}

// add a row at the end of the table
pub fn Table.append_row(row: Row): void {
    mut page: List<Row> = self.pager.get_page(self.num_rows / ROWS_PER_PAGE);
    page.push(row);
    self.num_rows += 1;
}

// db_close: save everything to the file
pub fn Table.close(): void {
    self.pager.flush(self.num_rows);
}